project_name = "eks-lz"
environment  = "demo"
owner        = "platform"
aws_region   = "eu-west-1"

vpc_cidr             = "10.40.0.0/16"
az_count             = 2
single_nat_gateway   = true
enable_vpc_endpoints = true

cluster_name       = "eks-lz-demo"
kubernetes_version = "1.31"

enable_eks       = true
enable_karpenter = true
enable_addons    = true

enable_alb_controller   = true
enable_external_dns     = false
enable_external_secrets = true
secrets_backend         = "secretsmanager"

# Production-shaped API access (see docs/runbooks/api-access.md)
endpoint_private_access = true
endpoint_public_access  = true
# Replace with your public IP / VPN egress — never leave as 0.0.0.0/0 outside demos
public_access_cidrs = ["REPLACE_WITH_YOUR_IP/32"]
